# Dependencies & build output (Vercel runs `npm install` + `vite build`)
node_modules/
dist/
.vite/

# Environment / secrets — never commit (set these in the Vercel dashboard)
.env
.env.*
# keep only the placeholder template, as documentation of required vars
!.env.example
serviceAccount*.json
firebase-adminsdk*.json
*.pem
*.key

# Local dev & Docker — not used by Vercel
Dockerfile
.dockerignore
docker-compose.yml
DOCKER.md
dev-api-server.mjs

# Firebase local state (firestore.rules itself IS tracked — deployed via Firebase CLI)
.firebase/
emulator-data/
firebase-debug.log
firestore-debug.log

# Security assessment artifacts (contain real hashes / findings — keep out of git)
claude/
scripts/

# Logs & OS/editor cruft
*.log
npm-debug.log*
.DS_Store
.idea/
.vscode/

# ===== Further files not needed for the Vercel deployment =====

# Vercel CLI local project link & settings
.vercel/

# Generated documentation / deliverables (built from source, not part of the app)
docs/

# Tests & one-off debug scripts (run locally, never routed or deployed)
*.test.js
*.test.mjs
*.test.jsx
*.spec.js
*.spec.mjs
__tests__/
api/_dump-nm.mjs

# Stale backups
*.old

# Alternate build output & tool caches
build/
coverage/
.eslintcache
.turbo/

# More logs & OS/editor cruft
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
Thumbs.db
ehthumbs.db
Desktop.ini
*.swp
*.swo
*~
