rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn()    { return request.auth != null; }
    function isOwner(uid)    { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin()       { return isSignedIn() && request.auth.token.admin == true; }
    // Admin implies teacher: an admin has every teacher capability plus admin-only ones.
    function isTeacher()     { return isSignedIn() && (request.auth.token.teacher == true || request.auth.token.admin == true); }
    function isList(v)       { return v is list; }
    // memberUids on class content: contains the student's uid => visible to them; [] => private.
    function isMember(d)     { return isSignedIn() && ('memberUids' in d) && (request.auth.uid in d.memberUids); }
    function isStr(v, n)     { return v is string && v.size() <= n; }
    function isCloudinary(v) { return v == null || (v is string && v.matches('https://res\\.cloudinary\\.com/[^ ]+')); }
    function articleOk(v)    { return v in ['', 'der', 'die', 'das', 'ein', 'eine']; }

    // Field-level checks shared by create & update.
    function wordFieldsOk(source) {
      let d = request.resource.data;
      return isStr(d.de, 100) && d.de.size() > 0
          && isStr(d.ru, 200) && (source == 'global' || d.ru.size() > 0)
          && articleOk(d.article)
          && isStr(d.example, 300)
          && (d.folderId == null || isStr(d.folderId, 64))
          && isCloudinary(d.imageUrl)
          && d.source == source
          && isStr(d.addedBy, 64)
          && (!('deRev' in d)     || d.deRev is int)
          && (!('updatedBy' in d) || d.updatedBy == request.auth.uid)   // un-spoofable
          && (!('updatedAt' in d) || d.updatedAt == request.time);       // forces serverTimestamp()
    }

    // Exact allowed key set — nothing else may be written (blocks field injection / doc bloat).
    function wordKeysOk(source) {
      let d = request.resource.data;
      return source == 'global'
        ? d.keys().hasOnly(['de', 'article', 'ru', 'example', 'folderId', 'imageUrl', 'addedBy', 'source', 'memberUids', 'deRev', 'updatedAt', 'updatedBy'])
        : d.keys().hasOnly(['de', 'article', 'ru', 'example', 'folderId', 'imageUrl', 'addedBy', 'source', 'deRev', 'updatedAt', 'updatedBy']);
    }

    function validWordCreate(source) {
      return wordFieldsOk(source) && wordKeysOk(source);
    }

    function validWordUpdate(source) {
      return wordFieldsOk(source) && wordKeysOk(source)
          && request.resource.data.source  == resource.data.source     // immutable
          && request.resource.data.addedBy == resource.data.addedBy;    // immutable
    }

    function validFolder(source) {
      let d = request.resource.data;
      return isStr(d.name, 60) && d.name.size() > 0
          && isStr(d.icon, 8)
          && d.source == source;
    }

    // Documents the class schema. Class docs are written only by the Admin SDK
    // (see /api/class-sync), which bypasses rules — so this gates nothing today,
    // but keeps the shape explicit for future client writes.
    function validClass() {
      let d = request.resource.data;
      return isStr(d.name, 60) && d.name.size() > 0
          && isStr(d.icon, 8) && isStr(d.createdBy, 64)
          && isList(d.memberUids) && isList(d.folders) && isList(d.wordIds);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
                    && request.resource.data.keys().hasOnly(['username', 'lang', 'createdAt'])
                    && isStr(request.resource.data.username, 32)
                    && isStr(request.resource.data.lang, 5);
      // username is the login identity (auth email is derived from it) — immutable after
      // creation. Only lang may change; other fields must stay as stored.
      allow update: if isOwner(uid)
                    && request.resource.data.keys().hasOnly(['username', 'lang', 'createdAt'])
                    && request.resource.data.username == resource.data.username
                    && isStr(request.resource.data.lang, 5);
      allow delete: if false;

      match /words/{wordId} {
        allow read:   if isOwner(uid);
        allow create: if isOwner(uid) && validWordCreate('personal')
                      && request.resource.data.addedBy == uid;
        allow update: if isOwner(uid) && validWordUpdate('personal')
                      && request.resource.data.addedBy == uid;
        allow delete: if isOwner(uid);
      }
      match /folders/{folderId} {
        allow read:           if isOwner(uid);
        allow create, update: if isOwner(uid) && validFolder('personal');
        allow delete:         if isOwner(uid);
      }
      match /meta/{docId} {
        allow read, write:    if isOwner(uid);
      }
    }

    // Class content (Kurs). Strict scoping: a student may read a doc only if their uid
    // is in its memberUids (i.e. it was assigned to one of their classes). Unassigned
    // content ([] memberUids) is private; teachers can read everything.
    match /global_words/{wordId} {
      allow read:   if isTeacher() || isMember(resource.data);
      allow create: if isTeacher() && validWordCreate('global');
      allow update: if isTeacher() && validWordUpdate('global');
      allow delete: if isTeacher();
    }
    match /global_folders/{folderId} {
      allow read:           if isTeacher() || isMember(resource.data);
      allow create, update: if isTeacher() && validFolder('global');
      allow delete:         if isTeacher();
    }
    // Classes: teachers see all; students see only classes they belong to.
    // All writes go through /api/class-sync (Admin SDK), so client writes are denied.
    match /classes/{classId} {
      allow read:  if isTeacher() || isMember(resource.data);
      allow write: if false;
    }
    match /global_translations/{lang}/words/{wordId} {
      allow read:  if isSignedIn();
      allow write: if false;
    }

    match /rate_limits/{doc} { allow read, write: if false; }

    // Admin-only server config (the teacher enrollment code). Admin SDK only — every
    // read/write goes through /api/admin, which enforces the admin claim.
    match /admin_config/{doc} { allow read, write: if false; }

    // ---- Legacy: deny (delete this collection after migration) -----------
    match /accounts/{doc} { allow read, write: if false; }

    // Default deny.
    match /{document=**} { allow read, write: if false; }
  }
}
