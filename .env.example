# Server-side env vars for the Vercel serverless functions (set in Vercel
# project settings — NEVER commit real values, NEVER expose to the client).

# Anthropic key for /api/translate (already required by the original app)
ANTHROPIC_KEY=

# Firebase Admin service-account JSON (single line) for token verification
# and setting the teacher custom claim. Alternatively use Application Default
# Credentials (GOOGLE_APPLICATION_CREDENTIALS).
FIREBASE_SERVICE_ACCOUNT=

# Teacher enrollment code — verified server-side by /api/claim-teacher.
# Set a FRESH secret; the old hard-coded "lehrer2024" is compromised.
TEACHER_CODE=

# Cloudinary — for signed uploads via /api/sign-cloudinary and the audio
# uploads made server-side by /api/pronounce
CLOUDINARY_CLOUD_NAME=pxc5e62k
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Azure Speech — text-to-speech for /api/pronounce. Without these the app still
# stores Worttrennung/IPA/Betonung, but produces no audio.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_SPEECH_VOICE=de-DE-SeraphinaMultilingualNeural

# Kill switch for the pronunciation feature — set to 0 to make /api/pronounce
# return 503 without any external call. Anything else (or unset) = enabled.
PRON_ENABLED=1

# Optional: comma-separated allowed browser origins for the /api CORS policy.
# Same-origin deployment needs nothing here.
# APP_ORIGIN=https://woerterkarten-1cek.vercel.app
